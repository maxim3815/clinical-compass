APP_NAME="Клинический компас"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Порт должен совпадать с APP_PORT ниже.
APP_URL=http://localhost:8080

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=clinical_compass
DB_USERNAME=clinical_compass
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"

# Reverb: сообщения чата и счётчики без перезагрузки страницы.
# Ключ и секрет только для локальной разработки, на стенде задаются свои.
REVERB_APP_ID=clinical-compass
REVERB_APP_KEY=local-reverb-key
REVERB_APP_SECRET=local-reverb-secret
# Приложение отправляет события в контейнер reverb напрямую.
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# Браузер подключается к Reverb через nginx по адресу приложения.
# Порт должен совпадать с APP_PORT ниже. После изменения: make down и make up.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# Docker. Порты публикуются только на 127.0.0.1.
APP_PORT=8080
VITE_PORT=5173
FORWARD_DB_PORT=54320

# SSR в разработке: php-контейнер ходит в Vite по имени сервиса, а не через localhost из public/hot.
INERTIA_SSR_HOT_URL=http://node:${VITE_PORT}

# UID и GID пользователя в контейнерах. Makefile сам передаёт id -u и id -g,
# задавать их здесь нужно, только если docker compose запускается без make.
# UID=1000
# GID=1000

# Xdebug ставится в образ при XDEBUG=true (после изменения: make build).
# XDEBUG_MODE: off, debug, coverage, profile; отладка запускается по триггеру.
XDEBUG=false
XDEBUG_MODE=off
